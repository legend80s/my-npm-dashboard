{
  "name": "npm-calf",
  "description": "🐘 An npm dashboard for your recently \"born\" packages",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "calf": "src/bin/index.js"
  },
  "scripts": {
    "tauri": "tauri",
    "typecheck": "tsgo --noEmit",
    "start": "node src/bin/index.js",
    "// dev:node-watch": "need reload page manually",
    "dev:node-watch": "node --watch-path=./src --watch src/bin/index.js",
    "dev:api": "cd src/backend && echo Y | pnpm i && node --watch ./dev-server/index.js",
    "dev:frontend": "live-server ./src --port=1123 --open=\"/frontend/?limit=3&username=antfu&port=8848\"",
    "// dev": "when static files changed, reload page automatically",
    "dev": "concurrently --kill-others --names \"LIVE,API\" \"pnpm dev:frontend\" \"pnpm dev:api\""
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.4",
    "live-server": "^1.2.2",
    "// cdn dependencies": "",
    "chart.js": "^4.5.1",
    "sourdough-toast": "^0.3.0"
  }
}
