{
  "name": "my-npm-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "marmot": "src/bin/index.js"
  },
  "scripts": {
    "tauri": "tauri",
    "typecheck": "tsgo --noEmit",
    "start": "node src/bin/index.js",
    "// dev": "need reload page manually",
    "dev": "node --watch-path=./src --watch src/bin/index.js",
    "dev:api": "cd src/backend && echo Y | pnpm i && node --watch ./dev-server/index.js",
    "dev:live": "live-server ./src --port=1123 --open=\"/frontend/?limit=3&username=antfu&port=8848\"",
    "// dev:live-server": "when static files changed, reload page automatically",
    "dev:live-server": "concurrently --kill-others --names \"LIVE,API\" \"pnpm dev:live\" \"pnpm dev:api\""
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.4",
    "live-server": "^1.2.2"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "sourdough-toast": "^0.3.0"
  }
}
