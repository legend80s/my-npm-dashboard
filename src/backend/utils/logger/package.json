{
  "name": "walking-log",
  "description": "A light-weight consola: A simple console.log only for printing messages in Node.js with colors, time, time diff and emojis. I use it in CLI app usually",
  "private": false,
  "version": "1.0.1",
  "type": "module",
  "main": "index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "index.js",
    "logger.type.ts"
  ],
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "generate:types": "tsc index.js --declaration --emitDeclarationOnly --outDir dist --ignoreConfig --allowJs",
    "commit": "bash ./scripts/git-commit.sh",
    "pub:patch": "npm version patch",
    "pub:minor": "npm version minor",
    "pub:major": "npm version major",
    "preversion": "npm test && npm run typecheck && npm run generate:types",
    "postversion": "npm publish && npm run commit && git push && git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/legend80s/my-npm-dashboard/blob/main/src/backend/utils/logger"
  },
  "homepage": "https://github.com/legend80s/my-npm-dashboard/blob/main/src/backend/utils/logger/README.md",
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "keywords": [
    "consola",
    "console",
    "log",
    "logger",
    "logging",
    "debug",
    "info",
    "warn",
    "error",
    "fatal",
    "node",
    "nodejs"
  ]
}
