{
  "name": "npm-calf",
  "description": "🐘 An npm dashboard for your recently \"born\" packages.",
  "private": false,
  "version": "1.2.0",
  "type": "module",
  "bin": {
    "calf": "./bin/index.js"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsgo --noEmit",
    "start": "node ./bin/index.js",
    "// dev:node-watch": "need reload page manually",
    "create:web-component": "node ./scripts/create-web-component.js",
    "dev:node-watch": "node --watch-path=./src --watch ./bin/index.js",
    "dev:api": "cd ./backend && echo Y | pnpm i && node --watch ./dev-server/index.js",
    "dev:frontend": "live-server ./src --port=1123 --open=\"/frontend/?limit=3&username=antfu&port=8848\"",
    "// dev": "when static files changed, reload page automatically",
    "dev": "concurrently --kill-others --names \"LIVE,API\" \"pnpm dev:frontend\" \"pnpm dev:api\"",
    "pub:patch": "npm version patch",
    "pub:minor": "npm version minor",
    "pub:major": "npm version major",
    "preversion": "npm test && npm run typecheck",
    "postversion": "npm publish && git push && git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legend80s/my-npm-dashboard.git"
  },
  "homepage": "https://github.com/legend80s/my-npm-dashboard/tree/main/src",
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.5",
    "walking-log": "^0.0.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.1",
    "chart.js": "^4.5.1",
    "concurrently": "^10.0.4",
    "live-server": "^1.2.2",
    "sourdough-toast": "^0.3.0"
  },
  "keywords": [
    "npm",
    "downloads",
    "statistics",
    "stats",
    "dashboard",
    "cli",
    "metrics",
    "packages",
    "monitoring",
    "developer-tools",
    "trends"
  ]
}
